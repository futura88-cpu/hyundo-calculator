{
  "buildCommand": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/home.html", "destination": "/api/page?name=home" },
    { "source": "/trunnion-template.html", "destination": "/api/page?name=trunnion-template" },
    { "source": "/y-tee.html", "destination": "/api/page?name=y-tee" },
    { "source": "/admin.html", "destination": "/api/page?name=admin" },
    { "source": "/manual.html", "destination": "/api/page?name=manual" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/app.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "functions": {
    "api/page.js": { "includeFiles": "private/**" }
  }
}
